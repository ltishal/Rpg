# ─── Провайдер модели ────────────────────────────────────────────────────
# Railway: эти же три переменные задайте в панели проекта, файл .env не нужен.

# Вариант A. Облако (нужен на Railway):
OPENAI_API_KEY=sk-or-v1-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=qwen/qwen-2.5-72b-instruct

# Вариант B. Локальная Ollama (только для запуска на своём компьютере):
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=qwen2.5:7b

# ─── Служебные вызовы (идут КАЖДЫЙ ход — берите модель подешевле) ────────
EXTRACT_MODEL=qwen/qwen-2.5-7b-instruct
SUMMARY_MODEL=qwen/qwen-2.5-7b-instruct

# ─── Лимиты ──────────────────────────────────────────────────────────────
LLM_MAX_CONCURRENT=2
LLM_QUEUE_TIMEOUT=120
LLM_TIMEOUT=300

# ─── Сохранения ──────────────────────────────────────────────────────────
# На Railway: подключите Volume с путём /data и раскомментируйте строку.
# SAVES_DIR=/data
SUMMARY_MAX_SESSIONS=128
